<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <!--Created with jdAppStreamEdit 9.2-->
  <id>land.arcana.TarotCanvas</id>
  <name>Tarot Canvas</name>
  <summary>Explore and arrange tarot decks</summary>
  <developer id="land.arcana">
    <name>Adam Fidel</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <update_contact>adam@arcana.land</update_contact>
  <description>
    <p>Tarot Canvas is a digital home for your personal tarot collection.</p>
    <ul>
      <li>Explore tarot deck imagery, metadata and esoterica.</li>
      <li>Place and arrange tarot cards from any deck on a virtual canvas.</li>
      <li>Create and add your own decks by following the standard tarot deck format.</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Main view of a single card</caption>
      <image type="source">https://raw.githubusercontent.com/arcanaland/tarot-canvas/main/packaging/screenshots/main-window.webp</image>
    </screenshot>
    <screenshot>
      <caption>Card meanings and other esoterica</caption>
      <image type="source">https://raw.githubusercontent.com/arcanaland/tarot-canvas/main/packaging/screenshots/esoterica-view.webp</image>
    </screenshot>
    <screenshot>
      <caption>View of an entire deck</caption>
      <image type="source">https://raw.githubusercontent.com/arcanaland/tarot-canvas/main/packaging/screenshots/deck-view.webp</image>
    </screenshot>
    <screenshot>
      <caption>A canvas of cards</caption>
      <image type="source">https://raw.githubusercontent.com/arcanaland/tarot-canvas/main/packaging/screenshots/canvas-view.webp</image>
    </screenshot>
    <screenshot>
      <caption>View of your library of tarot decks</caption>
      <image type="source">https://raw.githubusercontent.com/arcanaland/tarot-canvas/main/packaging/screenshots/library-view.webp</image>
    </screenshot>
    <screenshot>
      <caption>Take custom notes attached to cards</caption>
      <image type="source">https://raw.githubusercontent.com/arcanaland/tarot-canvas/main/packaging/screenshots/notes-view.webp</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.7.0" date="2026-10-12" type="development">
      <description>
        <ul>
          <li>Add esoterica to Library view.</li>
          <li>Rework settings window.</li>
          <li>Use hardware acceleration to improve performance of canvas motion.</li>
        </ul>
      </description>
    </release>
    <release version="1.6.2" date="2026-10-10" type="stable">
      <description>
        <p>Features</p>
        <ul>
          <li>Add Marseille deck</li>
          <li>Add keyboard shortcuts to switch tabs (Alt+1, Alt+2, etc)</li>
        </ul>
        <p>Minor changes</p>
        <ul>
          <li>Improve performance of deck view</li>
          <li>Bump KDE runtime</li>
        </ul>
      </description>
    </release>
    <release version="1.6.1" date="2026-10-08" type="stable">
      <description>
        <p>Add keywords to card overview tab.</p>
        <p>Fix Flathub metadata.</p>
      </description>
    </release>
    <release version="1.6.0" date="2026-10-08" type="stable">
      <description>
        <p>Overhauled esoterica tab (card meanings) and bundled a large dataset out-of-the-box.</p>
        <p>Other changes:</p>
        <ul>
          <li>Fixed sluggish launch of Find Card panel.</li>
        </ul>
      </description>
    </release>
    <release version="1.5.1" date="2026-09-25" type="stable">
      <description>
        <p>Quality of life and UX improvements for notes:</p>
        <ul>
          <li>Added most recent notes to the card overview.</li>
          <li>Reworked Notes tab to be more intuitive.</li>
          <li>Added a Notes section to the library to show notes for all cards.</li>
        </ul>
      </description>
    </release>
  </releases>
  <branding>
    <color type="primary" scheme_preference="light">#d9c0fa</color>
    <color type="primary" scheme_preference="dark">#3d2a5c</color>
  </branding>
  <url type="homepage">https://github.com/arcanaland/tarot-canvas</url>
  <url type="bugtracker">https://github.com/arcanaland/tarot-canvas/issues</url>
  <url type="faq">https://github.com/arcanaland/tarot-canvas/blob/main/docs/FAQs.md</url>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <!-- Although the app doesn't bundle any decks, the RWS deck is fetched by
       default. Some of its cards contain these attributes (The Star, The
       Lovers, etc) so it's better to list these to be safe. -->
  <content_rating type="oars-1.1">
    <content_attribute id="sex-nudity">mild</content_attribute>
    <content_attribute id="violence-fantasy">mild</content_attribute>
    <content_attribute id="violence-bloodshed">mild</content_attribute>
  </content_rating>
  <launchable type="desktop-id">land.arcana.TarotCanvas.desktop</launchable>
  <provides>
    <binary>tarot-canvas</binary>
    <id>tarot-canvas.desktop</id>
    <mediatype>x-scheme-handler/tarot</mediatype>
  </provides>
</component>
